; The stage's vertex shader.
;
; The PICA200 has no programmable fragment stage - only a fixed-function
; lighting unit driven by lookup tables and six texture combiners - so this is
; the whole of the programmable pipeline. Everything a fragment shader does on
; the tablet (`ui/gpu/StageShader.kt`) has to arrive here as vertex data or as
; a baked texture.
;
; For now the lighting is per-vertex and computed on the CPU from the same
; arithmetic `core/render/StageRig.kt` uses, and handed in as a colour. That is
; correct for a card, which is flat: a face has one normal, so a per-fragment
; Lambert term over it is constant anyway. It stops being enough for the
; turned solids of the room, which is what the fragment-lighting LUTs are for
; and is a later phase.

.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

.fvec projection[4], modelView[4]
; The card's own colour. The mesh's vertex colour carries the *face*
; shading - a lid brighter than a long edge brighter than a short one -
; and this multiplies it, so one static card mesh serves every card on the
; table and a draw costs a uniform rather than a vertex buffer rebuild.
.fvec matColor

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	; The position arrives as three floats; w is 1 for a point.
	mov r0.xyz, inpos
	mov r0.w,   ones

	; Into eye space.
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; And onto the screen. The projection carries the stereo offset, so the
	; two eyes differ by nothing else - see mt_gfx_scene.
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex
	mul outclr, inclr, matColor

	end
.end
