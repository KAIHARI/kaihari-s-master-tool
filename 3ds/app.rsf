# The exheader: what this title is allowed to do.
#
# ## Read this before wondering why the .cia crashes and the .3dsx does not
#
# A .3dsx runs under the Homebrew Launcher, inside a *host title's* process, and
# inherits that title's permissions - which are usually a game's, and generous.
# A .cia is its own title and gets exactly what this file grants it, so a
# service missing from ServiceAccessControl below is not a warning at build time
# and not a helpful error at run time: it is a hang or a black screen, on the
# console, after install. Every service the app will ever call is therefore
# listed here *now*, ahead of the code that calls it. Adding one later costs a
# reinstall; the cost of listing one early is nothing.
#
# ## Two numbers that are permanent
#
# UniqueId identifies the title to the console. Change it and the HOME menu sees
# a *different app*: a second icon, and the first one's save data orphaned with
# no way to reach it. It is chosen once, here, and never again - the same class
# of decision as the Android versionCode floor in CLAUDE.md.
#
# The title version (major.minor.micro, set by the Makefile from VERSION) must
# only ever increase, or FBI will not treat an install as an update.

BasicInfo:
  Title                   : "kai's master tool"
  ProductCode             : CTR-P-KMTL
  Logo                    : Homebrew

TitleInfo:
  Category                : Application
  # Chosen once. Arbitrary within the 0xFF000-0xFFFFF range homebrew uses to
  # stay clear of retail title ids. Never change this value.
  UniqueId                : 0xFF4D7

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCompress          : true
  EnableCrypt             : false

AccessControlInfo:
  CoreVersion             : 2
  DescVersion             : 2

  # Minimum kernel this title will run on (4.5.0).
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "33"

  UseExtSaveData          : false

  # 124MB and 804MHz are New 3DS figures, and setting them is what makes this a
  # New 3DS title: an Old 3DS will decline to launch it rather than run it badly.
  # That is deliberate - the marker AR pipeline has a CV pass in it, and the
  # honest answer to "does this run on a 2011 console" is no.
  SystemModeExt           : 124MB
  CpuSpeed                : 804MHz
  EnableL2Cache           : true
  # This, and not AffinityMask, is what lets a thread be placed on core 2 - so
  # the marker tracker can have a core to itself without stealing frames from
  # the renderer. docs/PORT.md risk 2 was written before this was found.
  CanAccessCore2          : true

  # Process settings
  MemoryType              : Application
  SystemMode              : 64MB
  IdealProcessor          : 0
  AffinityMask            : 1
  Priority                : 16
  MaxCpu                  : 0x9E
  HandleTableSize         : 0x200

  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # Decks, the card database and the art cache all live on the SD card, so the
  # write permission is as necessary as the read one. Nothing here needs NAND.
  FileSystemAccess:
    - CategorySystemApplication
    - DirectSdmc
    - DirectSdmcWrite

  IoAccessControl:

  # Virtual address mappings the graphics and audio stacks need.
  IORegisterMapping:
   - 1ff00000-1ff7ffff   # DSP memory
  MemoryMapping:
   - 1f000000-1f5fffff:r # VRAM

  # Accessible SVCs, <Name>:<ID>.
  #
  # This is 1-62 and 71-88: everything an application issues, including the
  # cache-maintenance and DMA calls (82-88) that the GPU and camera paths rely
  # on. What is deliberately *not* here is 96-125 - the debugger, process
  # creation, resource limits, Backdoor and KernelSetState. The common homebrew
  # template grants all of them; an application never issues one, and a title
  # that can attach a debugger to another process is a strictly worse thing to
  # install than one that cannot.
  #
  # If something ever fails on device with a syscall error, this comment is the
  # first place to look: the fix is to add the one call by name, not to paste
  # the whole list back in.
  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessAffinityMask: 4
    SetProcessAffinityMask: 5
    GetProcessIdealProcessor: 6
    SetProcessIdealProcessor: 7
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    GetThreadAffinityMask: 13
    SetThreadAffinityMask: 14
    GetThreadIdealProcessor: 15
    SetThreadIdealProcessor: 16
    GetCurrentProcessorNumber: 17
    Run: 18
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    SignalAndWait: 38
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    OpenProcess: 51
    OpenThread: 52
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    GetThreadContext: 59
    Break: 60
    OutputDebugString: 61
    ControlPerformanceCounter: 62
    CreatePort: 71
    CreateSessionToPort: 72
    CreateSession: 73
    AcceptSession: 74
    ReplyAndReceive1: 75
    ReplyAndReceive2: 76
    ReplyAndReceive3: 77
    ReplyAndReceive4: 78
    ReplyAndReceive: 79
    BindInterrupt: 80
    UnbindInterrupt: 81
    InvalidateProcessDataCache: 82
    StoreProcessDataCache: 83
    FlushProcessDataCache: 84
    StartInterProcessDma: 85
    StopDma: 86
    GetDmaState: 87
    RestartDma: 88

  ServiceAccessControl:
    # --- the floor: anything that draws, reads input or touches the SD card
    - APT:U
    - $hioFIO
    - $hostio0
    - $hostio1
    - ac:u                # wifi state, needed before http can connect
    - cfg:u               # region, language, and the 3D slider's calibration
    - fs:USER
    - gsp::Gpu
    - hid:USER
    - ndm:u               # yields the system's network daemon while we download
    - ns:s
    - ptm:u               # battery, and the pedometer-free bits of power state
    - ptm:sysm

    # --- audio (core/haptics has a sound vocabulary this inherits)
    - dsp::DSP

    # --- the cameras: marker AR, phase 4
    - cam:u
    - y2r:u               # hardware YUV->RGB, so the capture path costs no CPU

    # --- the network: card art over wi-fi, phase 5
    - http:C
    - soc:U
    - ssl:C

    # --- head tracking: phase 7, New 3DS only.
    # Listed now on purpose. qtm is the one service on this list the app does
    # not yet call, and it is here because the alternative is discovering in
    # phase 7 that every device with the app installed needs to reinstall it.
    - qtm:u

SystemControlInfo:
  SaveDataSize            : 0K        # decks and preferences live on the SD card
  RemasterVersion         : 0
  StackSize               : 0x40000

  Dependency:
    ac:                   0x0004013000002402
    am:                   0x0004013000001502
    camera:               0x0004013000001602
    cfg:                  0x0004013000001702
    codec:                0x0004013000001802
    dsp:                  0x0004013000001A02
    gpio:                 0x0004013000001B02
    gsp:                  0x0004013000001C02
    hid:                  0x0004013000001D02
    http:                 0x0004013000001E02
    i2c:                  0x0004013000001F02
    mcu:                  0x0004013000002001
    mic:                  0x0004013000002002
    ndm:                  0x0004013000002B02
    news:                 0x0004013000003502
    nim:                  0x0004013000002C02
    nwm:                  0x0004013000002D02
    pdn:                  0x0004013000002102
    ps:                   0x0004013000003102
    ptm:                  0x0004013000002202
    qtm:                  0x0004013020004202
    ro:                   0x0004013000003702
    socket:               0x0004013000002E02
    spi:                  0x0004013000002302
    ssl:                  0x0004013000002F02
